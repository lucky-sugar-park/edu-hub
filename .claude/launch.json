{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shell",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "backend-8088",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "backend\\gradlew.bat", "-p", "backend", "bootRun", "--args=--spring.profiles.active=dev --server.port=8088"],
      "port": 8088
    },
    {
      "name": "shell-8088",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd frontend\\apps\\shell && set API_PROXY_TARGET=http://localhost:8088&& npx vite --port 3003 --strictPort"],
      "port": 3003
    },
    {
      "name": "course-mfe",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/course-mfe"],
      "cwd": "frontend",
      "port": 3001
    },
    {
      "name": "enrollment-mfe",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/enrollment-mfe"],
      "cwd": "frontend",
      "port": 3002
    }
  ]
}
